# ─────────────────────────────────────────────────────────────
# Grow · environment
# API: copy to apps/api/.env. Web: put the NEXT_PUBLIC_* block in
# apps/web/.env.local. Every variable below is read by the code.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Stellar network (testnet defaults)
# ─────────────────────────────────────────────────────────────
STELLAR_NETWORK=TESTNET
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# ── MAINNET ──────────────────────────────────────────────────
# The app is network-driven: to go live, swap these values (no code
# changes) and mirror NEXT_PUBLIC_* in apps/web/.env.local.
#   STELLAR_NETWORK=PUBLIC
#   STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
#   SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com      # or a keyed provider
#   HORIZON_URL=https://horizon.stellar.org
#   USDC_CODE=USDC
#   USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN   # Circle USDC
#   USDC_TOKEN_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75 # its mainnet SAC
#   YIELD_SPLITTER_CONTRACT_ID=<deploy the contract to mainnet, see below>
#   DEFINDEX_VAULT_ADDRESS=<mainnet USDC vault>   DEFINDEX_API_KEY=<key>
#   BLEND_POOL_ID=<mainnet USDC pool>
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Contracts and assets
# ─────────────────────────────────────────────────────────────
# yield_splitter id printed by `bun run deploy` in packages/contracts.
# Testnet default: the app deployment described in docs/testnet.md.
YIELD_SPLITTER_CONTRACT_ID=CBEQUA2ET4XTZAMDB3ZOB6MUOA2B6ACZ6TV2GCDHFTETKBVG7TMBZCYA
# USDC Stellar Asset Contract (testnet) and the classic asset behind it,
# used for payments, trustlines and balances.
USDC_TOKEN_ID=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
USDC_CODE=USDC
USDC_ISSUER=GATALTGTWIOT6BUDBCZM3Q4OQ4BO2COLOAZ7IYSKPLC2PMSOPPGF5V56

# ─────────────────────────────────────────────────────────────
# Yield (DeFindex vault, Blend pool fallback for APY)
# ─────────────────────────────────────────────────────────────
# The API talks to the vault contract directly; no DeFindex key needed.
# Testnet USDC vault with a Blend strategy:
DEFINDEX_VAULT_ADDRESS=CBMVK2JK6NTOT2O4HNQAIQFJY232BHKGLIMXDVQVHIIZKDACXDFZDWHN
# Optional: with a key the rate comes from the DeFindex API.
DEFINDEX_API_KEY=
# Blend pool the vault's strategy supplies (rate when there is no key).
BLEND_POOL_ID=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF

# ─────────────────────────────────────────────────────────────
# Stats indexer (GET /api/stats). Polls the contract's events from
# Soroban RPC; RPC keeps ~7 days, so set the deploy ledger once.
# ─────────────────────────────────────────────────────────────
# STATS_START_LEDGER=<ledger the contract was deployed in>
# STATS_INDEXER=false            # turn the poller off

# ─────────────────────────────────────────────────────────────
# SEP-24 anchor (testnet reference anchor)
# ─────────────────────────────────────────────────────────────
ANCHOR_HOME_DOMAIN=testanchor.stellar.org
ANCHOR_TEST_ASSET=SRT

# ─────────────────────────────────────────────────────────────
# Postgres (Supabase). Optional: without it the API keeps
# remittances in memory. Individual vars win over DATABASE_URL and
# avoid URL-encoding issues with special characters in the password.
# ─────────────────────────────────────────────────────────────
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=postgres
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────
# API <-> web
# ─────────────────────────────────────────────────────────────
# Hosts like Railway inject PORT; API_PORT is the local fallback.
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Contract deploy (packages/contracts, `bun run deploy`)
# ─────────────────────────────────────────────────────────────
# SOROBAN_NETWORK=testnet        # stellar CLI network name
# STELLAR_IDENTITY=raiz          # deployer + admin; required on mainnet
# USER_CAP_USDC=100              # max savings held per recipient
# CONFIRM_MAINNET=yes            # required to deploy to mainnet

# ─────────────────────────────────────────────────────────────
# Frontend (apps/web/.env.local). Only NEXT_PUBLIC_* reach the
# browser, and they are baked in at build time.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_USDC_TOKEN_ID=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
